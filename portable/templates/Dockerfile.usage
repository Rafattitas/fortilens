FROM python:3.12-slim@sha256:1148dbb014615300fa7e713b2f94f550c0d1c69780c0805f84f093ceee34dd0b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONUTF8=1
WORKDIR /app
RUN mkdir -p /data && chown 10001:10001 /data
COPY accounting.py interfaces.py wan_health.py usage_service.py reporting.html /app/
USER 10001:10001
EXPOSE 8080
CMD ["python", "usage_service.py", "--config", "/config/site.json", "--password-file", "/run/secrets/usage_admin_password", "--token-file", "/run/secrets/fortigate_api_token"]
